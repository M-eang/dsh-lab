{
  "name": "dsh-lab",
  "version": "1.0.0",
  "author": "M-eang",
  "description": "Linux lab box cockpit for DSH: manage ssh tunnels, spot orphan listeners, discover remote services.",
  "type": "module",
  "main": "lib/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.tsx",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ssh",
    "tunnel",
    "lab"
  ],
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.2 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "react-dom"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p . --pretty false"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M-eang/dsh-lab.git"
  },
  "homepage": "https://github.com/M-eang/dsh-lab#readme",
  "bugs": {
    "url": "https://github.com/M-eang/dsh-lab/issues"
  },
  "private": false
}
